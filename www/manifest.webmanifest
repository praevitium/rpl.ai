{
  "id": "./",
  "name": "rpl.ai",
  "short_name": "rpl.ai",
  "description": "The HP 48/49/50 RPL calculator: stack, User-RPL, a computer algebra system, units, plotting and an assistant.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#13161b",
  "categories": ["education", "productivity", "utilities"],
  "related_applications": [{ "platform": "webapp", "url": "./manifest.webmanifest" }],
  "shortcuts": [
    { "name": "Equation writer", "short_name": "Equation", "description": "Write a formula in textbook form", "url": "./?open=equation", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Matrix writer", "short_name": "Matrix", "description": "Enter a matrix cell by cell", "url": "./?open=matrix", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Variables", "short_name": "Variables", "description": "Recall, edit and organise your variables", "url": "./?open=vars", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Search commands", "short_name": "Search", "description": "Find a command by name or by what it does", "url": "./?open=search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": { "action": "./", "method": "GET", "enctype": "application/x-www-form-urlencoded", "params": { "title": "title", "text": "text", "url": "url" } },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/app-icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
