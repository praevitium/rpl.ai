{
  "id": "./",
  "name": "rpl.ai",
  "short_name": "rpl.ai",
  "description": "The HP 48/49/50 RPL calculator: stack, User-RPL, a computer algebra system, units, plotting and an assistant.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#13161b",
  "categories": ["education", "productivity", "utilities"],
  "related_applications": [{ "platform": "webapp", "url": "./manifest.webmanifest" }],
  "share_target": { "action": "./", "method": "GET", "enctype": "application/x-www-form-urlencoded", "params": { "title": "title", "text": "text", "url": "url" } },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/app-icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
